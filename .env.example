# ─────────────────────────────────────────────────────────────────
#  Android TV Automation — Environment Variables
#  Copy this file to .env and fill in your real values.
#  .env is gitignored and will NEVER be committed.
# ─────────────────────────────────────────────────────────────────

# ── Client / app under test ───────────────────────────────────────
# Path to the JSON file that describes the app.
# Use a path relative to the project root, or an absolute path.
# Copy clients/template.json → clients/your_app.json and fill it in.
CLIENT_CONFIG=clients/rod_tv.json

# ── Login credentials ─────────────────────────────────────────────
LOGIN_EMAIL=your_email@example.com
LOGIN_PASSWORD=your_password_here

# ── Device connection ─────────────────────────────────────────────
# IP address of your Android TV (found in Settings → Network)
DEVICE_IP=192.168.1.100
# ADB port (default 5555)
ADB_PORT=5555
