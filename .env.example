# ─────────────────────────────────────────────────────────────────
#  Android TV Automation — Environment Variables
#  Copy this file to .env and fill in your real values.
#  .env is gitignored and will NEVER be committed.
# ─────────────────────────────────────────────────────────────────

# ── Login credentials ─────────────────────────────────────────────
ROD_TV_EMAIL=your_email@example.com
ROD_TV_PASSWORD=your_password_here

# ── Device connection ─────────────────────────────────────────────
# IP address of your Android TV (found in Settings → Network)
DEVICE_IP=192.168.1.100
# ADB port (default 5555)
ADB_PORT=5555
